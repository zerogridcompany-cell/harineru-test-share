   "色": "rgb(36, 27, 32)",
   "箱": null,
   "寄せ": "start"
  },
  {
   "型": "h2",
   "章": 3,
   "文": "母が、何をしていたか",
   "字": 20.3,
   "太": true,
   "色": "rgb(110, 42, 71)",
   "箱": null,
   "寄せ": "start"
  },
  {
   "型": "p",
   "章": 3,
   "文": "母が亡くなったあと、真紀さんは実家を片づけた。そこで、これまで見てきた景色の意味が全部つながったという。",
   "字": 16,
   "太": false,
   "色": "rgb(36, 27, 32)",
   "箱": null,
   "寄せ": "start"
  },
  {
   "型": "p",
   "章": 3,
