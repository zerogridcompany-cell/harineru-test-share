   "箱": null,
   "寄せ": "start"
  },
  {
   "型": "p",
   "章": 2,
   "文": "生理用ナプキンやおりものシートで代用する。尿もれパッドを重ねる。出かける前に水を控える。骨盤底筋の体操をする。紙パンツに",
   "字": 16,
   "太": false,
   "色": "rgb(36, 27, 32)",
   "箱": null,
   "寄せ": "start"
  },
  {
   "型": "p",
   "章": 2,
